# Decision model: simulated | laya
DOCTYPE_MODEL=simulated
LAYA_REPO=convaiinnovations/laya
# typed-decisions | multilingual | english (blank = english root checkpoint)
LAYA_SUBFOLDER=typed-decisions

# Fallback classifier: simulated | ollama | bedrock
DOCTYPE_FALLBACK=simulated
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b-mlx
AWS_REGION=eu-west-2
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Trainer: simulated | export | laya
DOCTYPE_TRAINER=simulated
# Base checkpoint for fine-tuning: alias (english | multilingual), Hub id or local dir
LAYA_BASE=english
# auto | cpu | cuda | mps
LAYA_DEVICE=auto
LAYA_OUTPUT_DIR=./models

# Gate and sampling
DOCTYPE_THRESHOLD=0.85
DOCTYPE_AUDIT_RATE=0.25
